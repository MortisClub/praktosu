<Window x:Class="PRATKT1_vagin.SizeInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Размер массива" Height="140" Width="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="tbSize" FontSize="14" Margin="0,0,0,10" KeyDown="tbSize_KeyDown"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Style="{StaticResource DialogButton}" Margin="0,0,8,0" Click="btnOk_Click"/>
            <Button Content="Отмена" Style="{StaticResource DialogButton}" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>